   "source": [
    "select\n",
    "  state_abbr,\n",
    "  sum(cast(replace(`GHG emissions mtons CO2e`, ',', '') as double)) as total_emission_co2\n",
    "from\n",
    "  emissions_data\n",
    "group by\n",
    "  state_abbr\n",
    "order by\n",
    "  total_emission_co2 desc;"
