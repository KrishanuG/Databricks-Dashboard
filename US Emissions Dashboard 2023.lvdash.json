{
  "datasets": [
    {
      "name": "0d19ebe1",
      "displayName": "Location Data",
      "queryLines": [
        "  select latitude, longitude, `GHG emissions mtons CO2e` AS emission from emissions.default.emissions_data"
      ]
    },
    {
      "name": "b0330266",
      "displayName": "Emissions per person",
      "queryLines": [
        "select\r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  cast(replace(`GHG emissions mtons CO2e`, ',', '') as double)\r\n",
        "  / cast(population as double) AS emission_per_person\r\n",
        "from\r\n",
        "  emissions_data\r\n",
        "order by\r\n",
        "  emission_per_person desc;"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "0c155227",
      "displayName": "Total emission per state",
      "queryLines": [
        "select\r\n",
        "  state_abbr,\r\n",
        "  sum(cast(replace(`GHG emissions mtons CO2e`, ',', '') as double)) as total_emission_co2\r\n",
        "from\r\n",
        "  emissions_data\r\n",
        "group by\r\n",
        "  state_abbr\r\n",
        "order by\r\n",
        "  total_emission_co2 desc\r\n",
        "  limit 10;"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "54a8c122",
      "displayName": "county wise emission",
      "queryLines": [
        "select\r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  cast(replace(`GHG emissions mtons CO2e`, ',', '') as double) As total_emissions\r\n",
        "from\r\n",
        "  emissions_data\r\n",
        "order by\r\n",
        "  total_emissions desc\r\n",
        "limit 10;"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
