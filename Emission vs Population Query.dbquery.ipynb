   "source": [
    "select\n",
    "  county_state_name,\n",
    "  population,\n",
    "  cast(replace(`GHG emissions mtons CO2e`, ',', '') as double)\n",
    "  / cast(population as double) AS emission_per_person\n",
    "from\n",
    "  emissions_data\n",
    "order by\n",
    "  emission_per_person desc\n",
    "limit 10;"
   ]
